APP_NAME=BANAPALL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL
APP_TIMEZONE=America/Santiago

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=banapal
DB_USERNAME=banapal
DB_PASSWORD=banapal_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="ventas@banapal.cl"
MAIL_FROM_NAME="${APP_NAME}"

BANAPAL_BASE_CURRENCY=CLP
BANAPAL_COMPANY_NAME="BANAPALL SpA"
BANAPAL_COMPANY_TAX_ID=76.543.210-8
BANAPAL_COMPANY_ADDRESS="Av. Palta 1200, Santiago, Chile"
BANAPAL_COMPANY_ACTIVITY="Packing y comercialización de paltas orgánicas"
